<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E1E1E"
    android:padding="16dp"
    android:elevation="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Сопряжение ADB"
        android:textColor="#EDEDED"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Данные — из Настроек → Отладка по WiFi → Сопряжение"
        android:textColor="#9A9A9A"
        android:textSize="12sp"/>

    <EditText
        android:id="@+id/inputPairPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Порт сопряжения"
        android:inputType="number"
        android:textColor="#EDEDED"
        android:textColorHint="#707070"/>

    <EditText
        android:id="@+id/inputPairCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Код (6 цифр)"
        android:inputType="number"
        android:maxLength="6"
        android:textColor="#EDEDED"
        android:textColorHint="#707070"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelPair"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Отмена"/>

        <Button
            android:id="@+id/btnDoPair"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Спарить"/>
    </LinearLayout>
</LinearLayout>
